DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=livia.smartcontrolbrasil.com.br,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://livia.smartcontrolbrasil.com.br
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=300
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Banco de dados
# Desenvolvimento local sem DATABASE_URL usa SQLite em db.sqlite3 quando DJANGO_DEBUG=True.
# Exemplo SQLite explícito para desenvolvimento: DATABASE_URL=sqlite:///db.sqlite3
# Exemplo PostgreSQL local fictício: DATABASE_URL=postgresql://livia_local:livia_local_password@127.0.0.1:55432/livia_platform?sslmode=disable
# Produção exige DATABASE_URL PostgreSQL; nunca use senha real neste arquivo de exemplo.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
# Proteção extra: testes com DATABASE_URL externa são bloqueados por padrão.
DJANGO_ALLOW_EXTERNAL_TEST_DATABASE_URL=False

LIVIA_ALLOWED_WIDGET_ORIGINS=https://www.smartcontrolbrasil.com.br,https://smartcontrolbrasil.com.br
LIVIA_MAX_MESSAGE_LENGTH=1200
LIVIA_CHAT_RATE_LIMIT_ENABLED=True
LIVIA_CHAT_RATE_LIMIT_REQUESTS=20
LIVIA_CHAT_RATE_LIMIT_WINDOW_SECONDS=300
LIVIA_SPAM_GUARD_ENABLED=True

LIVIA_AI_ENABLED=False
LIVIA_AI_DRY_RUN=True
LIVIA_OPENAI_API_KEY=
LIVIA_OPENAI_MODEL=gpt-4.1-mini
LIVIA_OPENAI_TIMEOUT_SECONDS=8
LIVIA_OPENAI_MAX_OUTPUT_TOKENS=350
LIVIA_OPENAI_TEMPERATURE=0.3

SMART360_BASE_URL=https://www.smartcontrolbrasil.com.br
SMART360_M2M_TOKEN=
SMART360_LEAD_DISPATCH_ENABLED=False
SMART360_LEAD_DISPATCH_DRY_RUN=True

LIVIA_HANDOFF_NOTIFICATIONS_ENABLED=False
LIVIA_HANDOFF_NOTIFICATIONS_DRY_RUN=True
LIVIA_HANDOFF_NOTIFICATION_EMAIL=contato@smartcontrolbrasil.com.br

LIVIA_WEBHOOKS_ENABLED=False
LIVIA_WEBHOOKS_DRY_RUN=True
LIVIA_WEBHOOK_TIMEOUT_SECONDS=6
