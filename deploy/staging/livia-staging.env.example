# Lívia Platform — staging físico GP (template sem segredos)
# Copiar para .env no servidor (NUNCA versionar .env real):
#   cp deploy/staging/livia-staging.env.example .env
#
# Produção permanece em /home/livia.smartcontrolbrasil.com.br/ (porta 8011, SQLite).
# Staging usa diretório, serviço, banco e porta distintos.

# --- Django core ---
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging-livia.smartcontrolbrasil.com.br,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging-livia.smartcontrolbrasil.com.br
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=300
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# --- Ambiente operacional ---
LIVIA_ENVIRONMENT=staging

# --- Banco (PostgreSQL local na VPS — NUNCA apontar para produção) ---
DATABASE_URL=postgresql://livia_staging_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/livia_staging
DATABASE_CONN_MAX_AGE=60
DJANGO_ALLOW_EXTERNAL_TEST_DATABASE_URL=False

# --- Bind interno (Gunicorn / systemd) ---
LIVIA_STAGING_BIND_HOST=127.0.0.1
LIVIA_STAGING_BIND_PORT=8012

# --- Widget / API pública ---
LIVIA_ALLOW_ORIGINLESS_PUBLIC_API=False
LIVIA_MAX_MESSAGE_LENGTH=1200
LIVIA_CHAT_RATE_LIMIT_ENABLED=True
LIVIA_CHAT_RATE_LIMIT_REQUESTS=20
LIVIA_CHAT_RATE_LIMIT_WINDOW_SECONDS=300
LIVIA_CHAT_PROCESSING_TIMEOUT_SECONDS=30
LIVIA_SPAM_GUARD_ENABLED=True

# --- IA / OpenAI (preencher no servidor; não commitar) ---
LIVIA_AI_ENABLED=True
LIVIA_AI_DRY_RUN=False
LIVIA_OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
LIVIA_OPENAI_MODEL=gpt-4.1-mini
LIVIA_OPENAI_TIMEOUT_SECONDS=8
LIVIA_OPENAI_MAX_OUTPUT_TOKENS=350
LIVIA_OPENAI_TEMPERATURE=0.3

# --- RAG / embeddings GP-only ---
LIVIA_RAG_ENABLED=True
LIVIA_RAG_DRY_RUN=False
LIVIA_RAG_INDEXING_ENABLED=True
# Valor operacional no código: postgres_pgvector (auto também aceito em staging PG)
LIVIA_RAG_VECTOR_BACKEND=postgres_pgvector
LIVIA_RAG_EMBEDDING_PROVIDER=openai
LIVIA_ALLOW_FAKE_EMBEDDINGS=False
LIVIA_RAG_ACTIVE_TENANT_ALLOWLIST=granimarmores-pitondo
LIVIA_RAG_EMBEDDING_MODEL=text-embedding-3-small
LIVIA_RAG_EMBEDDING_DIMENSION=1536
LIVIA_RAG_EMBEDDING_API_KEY=CHANGE_ME_OPENAI_EMBEDDING_KEY
LIVIA_RAG_MIN_SIMILARITY_SCORE=0.40
LIVIA_RAG_MAX_RETRIEVED_CHUNKS=5
LIVIA_RAG_MAX_CONTEXT_CHARS=3000
LIVIA_RAG_MAX_CHUNKS_PER_MANIFEST=2
LIVIA_RAG_VECTOR_CANDIDATE_LIMIT=20
LIVIA_RAG_CHUNK_SIZE_CHARS=1200
LIVIA_RAG_CHUNK_OVERLAP_CHARS=120
LIVIA_RAG_MAX_CHUNKS_PER_DOCUMENT=400
LIVIA_RAG_EXPORT_MAX_BYTES=1000000
LIVIA_RAG_SYNC_RUNNING_TIMEOUT_SECONDS=1800
LIVIA_RAG_INDEX_RUNNING_TIMEOUT_SECONDS=1800
LIVIA_RAG_ADMIN_SEARCH_MAX_RESULTS=20

# --- Grounded synthesis GP-only ---
LIVIA_AI_GROUNDED_SYNTHESIS_ENABLED=True
LIVIA_AI_GROUNDED_SYNTHESIS_TENANT_ALLOWLIST=granimarmores-pitondo

# --- Google Drive RAG (readonly export — caminho absoluto no servidor) ---
LIVIA_GOOGLE_SERVICE_ACCOUNT_FILE=/home/livia-staging/secrets/google-drive-service-account.json

# --- Integrações externas: OFF ou DRY-RUN em staging ---
SMART360_BASE_URL=https://www.smartcontrolbrasil.com.br
SMART360_M2M_TOKEN=CHANGE_ME_SMART360_TOKEN
SMART360_LEAD_DISPATCH_ENABLED=False
SMART360_LEAD_DISPATCH_DRY_RUN=True

LIVIA_WEBHOOKS_ENABLED=False
LIVIA_WEBHOOKS_DRY_RUN=True
LIVIA_WEBHOOK_TIMEOUT_SECONDS=6

LIVIA_HANDOFF_NOTIFICATIONS_ENABLED=False
LIVIA_HANDOFF_NOTIFICATIONS_DRY_RUN=True
LIVIA_HANDOFF_NOTIFICATION_EMAIL=contato@smartcontrolbrasil.com.br

# --- Outbox (processamento real somente com --execute explícito) ---
LIVIA_OUTBOX_LOCK_TIMEOUT_SECONDS=60
LIVIA_OUTBOX_BATCH_SIZE=20
LIVIA_OUTBOX_MAX_ATTEMPTS=3
LIVIA_OUTBOX_BASE_RETRY_SECONDS=30
LIVIA_OUTBOX_MAX_RETRY_SECONDS=3600
